<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Database Notice - nestadesign.co.rw</title>
    <!-- Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts for Handwriting and Clean Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome for Icons/Stickers -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        handwriting: ['Caveat', 'cursive'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#0284c7',
                            600: '#0265d2',
                            700: '#0369a1',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .handwritten-note {
            transform: rotate(-2deg);
        }
        .glow-effect {
            box-shadow: 0 0 25px rgba(2, 132, 199, 0.15);
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 font-sans min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden">

    <!-- Background Decorative Elements (Stickers / Gradients) -->
    <div class="absolute top-10 left-10 text-slate-800 text-9xl opacity-20 select-none pointer-events-none">
        <i class="fa-solid fa-database"></i>
    </div>
    <div class="absolute bottom-10 right-10 text-slate-800 text-9xl opacity-20 select-none pointer-events-none">
        <i class="fa-solid fa-shield-halved"></i>
    </div>

    <!-- Main Container Card -->
    <div class="max-w-3xl w-full bg-slate-800/90 backdrop-blur-md rounded-2xl border border-slate-700/60 p-6 md:p-10 shadow-2xl relative z-10 glow-effect">
        
        <!-- Header Section -->
        <div class="flex items-center justify-between border-b border-slate-700 pb-6 mb-6">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 bg-red-500/10 text-red-400 rounded-xl flex items-center justify-center text-2xl border border-red-500/20">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div>
                    <h1 class="text-xs font-bold tracking-widest text-slate-400 uppercase">System Status Notice</h1>
                    <p class="text-lg font-bold text-white">nestadesign.co.rw</p>
                </div>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                <span class="w-2 h-2 rounded-full bg-amber-400 mr-2 animate-pulse"></span> Action Required
            </span>
        </div>

        <!-- TAB 1: Main Notice -->
        <div id="tab-notice" class="space-y-6">
            
            <!-- Real Tech Image Header -->
            <div class="relative h-48 rounded-xl overflow-hidden border border-slate-700">
                <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1200&q=80" alt="Server Database" class="w-full h-full object-cover opacity-60">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
                
                <!-- Personal Sticker/Badge -->
                <div class="absolute bottom-4 left-4 right-4 flex justify-between items-end">
                    <div class="bg-slate-900/80 backdrop-blur-md px-4 py-2 rounded-lg border border-slate-700">
                        <span class="text-xs text-slate-400 block">Target Account</span>
                        <span class="text-sm font-bold text-sky-400">HITIMANA JEAN</span>
                    </div>
                    
                    <div class="bg-red-500 text-white font-bold text-xs px-3 py-1.5 rounded-md shadow-lg flex items-center gap-1.5">
                        <i class="fa-solid fa-hard-drive"></i> Database 100% Full
                    </div>
                </div>
            </div>

            <!-- Handwritten Custom Note -->
            <div class="handwritten-note bg-amber-100/10 border-l-4 border-amber-400 p-4 rounded-r-xl relative">
                <p class="font-handwriting text-2xl text-amber-200 leading-snug">
                    <i class="fa-solid fa-quote-left text-amber-400/50 mr-2"></i>
                    Hi HITIMANA JEAN, your website database is now full! You need to connect it back to your current data registered in the name of MANIRIHO Thierry or pay for your own database, or keep collaborating with MANIRIHO Thierry's database so that you can get back into your official website: <span class="underline text-amber-300">nestadesign.co.rw</span>.
                </p>
            </div>

            <!-- Information Grid -->
            <div class="grid md:grid-cols-2 gap-4 pt-2">
                <div class="p-4 bg-slate-700/30 rounded-xl border border-slate-700/50">
                    <div class="flex items-center space-x-3 text-sky-400 mb-2">
                        <i class="fa-solid fa-database text-lg"></i>
                        <h3 class="font-semibold text-white">Current Registered Owner</h3>
                    </div>
                    <p class="text-sm text-slate-300">MANIRIHO Thierry</p>
                </div>

                <div class="p-4 bg-slate-700/30 rounded-xl border border-slate-700/50">
                    <div class="flex items-center space-x-3 text-sky-400 mb-2">
                        <i class="fa-solid fa-globe text-lg"></i>
                        <h3 class="font-semibold text-white">Affected Domain</h3>
                    </div>
                    <p class="text-sm text-slate-300">nestadesign.co.rw</p>
                </div>
            </div>

            <!-- Action Button -->
            <button onclick="goToTab('tab-payment')" class="w-full py-4 bg-sky-600 hover:bg-sky-500 text-white font-bold rounded-xl transition duration-200 flex items-center justify-center space-x-2 shadow-lg shadow-sky-600/30">
                <span>Proceed to Resolution & Payment Options</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>

        <!-- TAB 2: Payment Options -->
        <div id="tab-payment" class="space-y-6 hidden">
            
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-bold text-white">Select Payment Method</h2>
                    <p class="text-sm text-slate-400">Choose how you would like to restore your database access.</p>
                </div>
                <button onclick="goToTab('tab-notice')" class="text-xs text-slate-400 hover:text-white underline">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Back to Notice
                </button>
            </div>

            <!-- Option 1: Crypto (USDT BEP20) -->
            <div class="p-6 bg-slate-700/40 border border-slate-600 rounded-2xl relative overflow-hidden group hover:border-sky-500/50 transition duration-200">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-yellow-500/10 text-yellow-500 rounded-lg flex items-center justify-center text-xl">
                            <i class="fa-brands fa-bitcoin"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-white">Option 1: Pay Your Own Database</h3>
                            <p class="text-xs text-slate-400">USDT via BNB Smart Chain (BEP20)</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="text-2xl font-extrabold text-amber-400">$86</span>
                        <span class="text-xs text-slate-400 block">USDT / year</span>
                    </div>
                </div>

                <!-- Network Badge -->
                <div class="mb-4 inline-flex items-center px-2.5 py-1 rounded-md bg-yellow-500/10 text-yellow-400 border border-yellow-500/20 text-xs font-semibold">
                    <i class="fa-solid fa-network-wired mr-1.5"></i> BNB Smart Chain (BEP20)
                </div>

                <!-- Wallet Address Field -->
                <div class="bg-slate-900 p-3 rounded-lg flex items-center justify-between border border-slate-700">
                    <span id="crypto-addr" class="font-mono text-xs md:text-sm text-slate-300 break-all select-all">0x4544531a4b839448e903fc613b0f416a2a1d5b92</span>
                    <button onclick="copyToClipboard('crypto-addr')" class="ml-2 px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 rounded-md border border-slate-600 transition flex items-center shrink-0">
                        <i class="fa-solid fa-copy mr-1"></i> Copy
                    </button>
                </div>
            </div>

            <!-- Option 2: MTN MoMo Pay -->
            <div class="p-6 bg-slate-700/40 border border-slate-600 rounded-2xl relative overflow-hidden group hover:border-yellow-500/50 transition duration-200">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-yellow-400 text-slate-900 rounded-lg flex items-center justify-center text-xl font-black">
                            MoMo
                        </div>
                        <div>
                            <h3 class="font-bold text-white">Option 2: Pay Collaborator</h3>
                            <p class="text-xs text-slate-400">Collaborate with MANIRIHO Thierry's Database</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="text-2xl font-extrabold text-emerald-400">80,000</span>
                        <span class="text-xs text-slate-400 block">FRW / Forever</span>
                    </div>
                </div>

                <div class="bg-slate-900 p-4 rounded-lg border border-slate-700 space-y-3">
                    <div class="flex justify-between items-center text-xs text-slate-400">
                        <span>Receiver Name:</span>
                        <span class="font-semibold text-white">MANIRIHO Thierry</span>
                    </div>
                    
                    <!-- Direct Dialer Button -->
                    <a href="tel:*182*1*1*0790052780*80000%23" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-lg flex items-center justify-center space-x-2 transition shadow-md">
                        <i class="fa-solid fa-phone-flip"></i>
                        <span>Pay via USSD: *182*1*1*0790052780*80000#</span>
                    </a>
                </div>
            </div>

            <!-- Footer note inside payment section -->
            <div class="text-center pt-2">
                <p class="text-xs text-slate-500">Once payment is confirmed, access to <span class="text-slate-400">nestadesign.co.rw</span> will be restored immediately.</p>
            </div>
        </div>

    </div>

    <!-- JavaScript to handle Tab switching and Copy functionality -->
    <script>
        function goToTab(tabId) {
            document.getElementById('tab-notice').classList.add('hidden');
            document.getElementById('tab-payment').classList.add('hidden');
            
            document.getElementById(tabId).classList.remove('hidden');
        }

        function copyToClipboard(elementId) {
            const textToCopy = document.getElementById(elementId).innerText;
            navigator.clipboard.writeText(textToCopy).then(() => {
                alert('Wallet address copied to clipboard!');
            }).catch(err => {
                console.error('Failed to copy: ', err);
            });
        }
    </script>
</body>
</html>
